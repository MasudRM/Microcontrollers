//use_of_debounce_delay//

#include <avr/io.h> //AVR input-output header file 
#include <util/delay.h> //AVR header file for delay funcion 

void main(void)
{

DDRC |= ((1<<0) | (1<<1) | (1<<2) | (1<<3) | (1<<4) | (1<<5) | (1<<6) | (1<<7));//Declare all Data_Direction_Registor_Of_PORTC as output pin. 

DDRD &= ~((1<<2) | (1<<3));//Declare Data_Direction_Register_Of_PORTD_Bit_2_&_3 as input pin. 


	while(1)
	{
		if(bit_is_clear(PIND, 2))//Check the switch is pressed or not ? 
		{
			//_delay_us(10);//Debounce delay 
			while(bit_is_clear(PIND, 2))//Until the switch is pressed. 
			{
				PORTC = 0x0F;//The first 4-bit of PORTC goes to HIGH and last 4-bit bits goes to LOW.
			}
			 
		}
		
		else if(bit_is_clear(PIND, 3))//Check the switch is pressed or not ?
		{
			//_delay_us(10);//Debounce delay 
			while(bit_is_clear(PIND, 3))//Until the switch is pressed. 
			{
				PORTC = 0xF0;;//The last 4-bit of PORTC goes to HIGH and fast 4-bit bits goes to LOW. 
			}
		}
		
		else PORTC = 0x00;//For any other conditions, all bit of PORTC goes to LOW. 
	}
}
